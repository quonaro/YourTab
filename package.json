{
  "name": "yourtab-extension",
  "description": "YourTab Chrome extension — agile board in your new tab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.3",
    "vue-tsc": "^2.2.0",
    "web-ext": "^8.3.0",
    "wxt": "^0.19.13"
  },
  "dependencies": {
    "@tabler/icons-vue": "^3.46.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13"
  }
}
